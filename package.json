{
  "name": "agent-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local desktop workbench for code agent CLIs. No account, no cloud.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "node scripts/dist-win.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check": "node scripts/review-check.mjs && node scripts/terminal-check.mjs && node scripts/ssh-password-check.mjs && node scripts/render-check.mjs && node scripts/workspace-check.mjs",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "5.5.0",
    "node-pty": "1.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "33.4.11",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
