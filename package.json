{
  "name": "pello",
  "version": "0.1.19",
  "private": true,
  "description": "Local desktop workbench for code agent CLIs. No account, no cloud.",
  "license": "Apache-2.0",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist:win": "node scripts/dist-win.mjs",
    "mcp:opencode": "node scripts/opencode-mcp-list.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src scripts electron.vite.config.ts --max-warnings 0 && node scripts/invariant-lint.mjs && node scripts/invariant-lint-check.mjs",
    "check": "node scripts/check-suite.mjs",
    "check:menus": "node scripts/menu-position-check.mjs",
    "check:remote-access": "node scripts/terminal-context-check.mjs && node scripts/remote-access-check.mjs",
    "check:skill-discovery": "node scripts/skill-discovery-ui-check.mjs",
    "check:performance": "node scripts/check-suite.mjs performance",
    "check:hotspots": "node scripts/check-suite.mjs hotspots",
    "bench:large-project": "node scripts/prepare-large-project.mjs && node scripts/large-project-check.mjs --phase=after --enforce-budget",
    "check:files": "node scripts/check-suite.mjs files",
    "check:shells": "node scripts/local-shells-check.mjs",
    "check:files:ssh-linux": "node scripts/linux-rename-check.mjs && node scripts/linux-ssh-rename-check.mjs && node scripts/upload-replace-check.mjs --linux",
    "check:files:ssh-auth": "node scripts/ssh-file-auth-check.mjs",
    "verify": "npm run verify:prepare && npm run check",
    "verify:prepare": "node scripts/check-suite.mjs prepare",
    "verify:release": "npm run verify && npm run dist:win -- --skip-build && npm run check:installation",
    "check:release-workflow": "node scripts/release-workflow-check.mjs",
    "postinstall": "electron-rebuild -f -w node-pty",
    "check:sessions:deep": "node scripts/codex-native-session-check.mjs && node scripts/pi-native-session-check.mjs",
    "check:custom-agent": "node scripts/check-suite.mjs customAgent",
    "check:executor-templates": "node scripts/executor-templates-check.mjs",
    "check:custom-agent:ssh-linux": "node scripts/custom-agent-remote-check.mjs",
    "check:custom-agent:native": "node scripts/qwen-native-session-check.mjs",
    "check:i18n": "node scripts/i18n-check.mjs",
    "check:installation": "node scripts/check-suite.mjs installation",
    "check:upgrade:deep": "node scripts/update-upgrade-check.mjs --target=0.1.14 && node scripts/update-upgrade-check.mjs --target=0.1.15",
    "check:media:ssh-linux": "node scripts/linux-media-check.mjs",
    "check:remote-open": "node scripts/remote-read-check.mjs && node scripts/remote-open-check.mjs && node scripts/remote-open-check.mjs --linux",
    "check:source-gutter": "node scripts/source-gutter-check.mjs",
    "check:terminal:omp-paste": "node scripts/terminal-omp-paste-check.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.12",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "node-pty": "1.1.0",
    "smol-toml": "^1.9.1",
    "ssh2": "^1.17.0",
    "toml-eslint-parser": "^0.10.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/rebuild": "^3.7.2",
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "^5.2.6",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.19.0",
    "@types/plantuml-encoder": "^1.4.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-search": "0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "5.5.0",
    "electron": "33.4.11",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "highlight.js": "^11.12.0",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "6.5.438",
    "plantuml-encoder": "^1.4.0",
    "postcss": "^8.5.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.1"
  }
}
