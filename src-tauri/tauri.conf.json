{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pello",
  "version": "0.1.12",
  "identifier": "com.pello.app",
  "build": {
    "beforeDevCommand": "npm run dev:tauri:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:tauri:web",
    "frontendDist": "../dist/tauri"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/pello-console-reply"]
  }
}
